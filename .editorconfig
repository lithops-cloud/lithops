root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.py]
max_line_length = 120

[*.{yml,yaml,json}]
indent_size = 2

[*.md]
indent_size = 2
# two trailing spaces are a hard line break in Markdown
trim_trailing_whitespace = false

[*.rst]
indent_size = 3

[Makefile]
indent_style = tab
